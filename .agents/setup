#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() { echo "==> $*"; }
timed() { local start=$SECONDS; "$@"; echo "    done in $((SECONDS - start))s"; }

if ! command -v bun >/dev/null 2>&1; then
  step "Installing Bun"
  timed bash -c 'curl -fsSL https://bun.sh/install | bash'
  # The installer cannot update this running script's environment.
  export PATH="$HOME/.bun/bin:$PATH"
fi
echo "bun $(bun --version)"

step "Installing dependencies"
timed bun install --frozen-lockfile
